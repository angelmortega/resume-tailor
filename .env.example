# Get a key at https://console.anthropic.com → API keys (and add a few dollars of credit under Billing)
ANTHROPIC_API_KEY=

# Optional. claude-sonnet-5 at medium effort is the default (good quality, low cost).
# For the strongest (about 2.5x pricier) option: MODEL=claude-opus-5 and EFFORT=high
MODEL=claude-sonnet-5
EFFORT=medium
